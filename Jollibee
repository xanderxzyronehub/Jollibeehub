local function notify(text, type)
    local accentColor = COLORS.BEE_YELLOW
    if type == "success" then accentColor = COLORS.GREEN end
    if type == "error" then accentColor = COLORS.RED end
    if type == "warn" then accentColor = COLORS.ORANGE end
    if type == "premium" then accentColor = COLORS.BEE_HONEY end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 260, 0, 38)
    frame.Position = UDim2.new(1, 10, 1, -55)
    frame.BackgroundColor3 = COLORS.BG_MAIN
    frame.BackgroundTransparency = 0.05
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = accentColor
    stroke.Thickness = 2
    stroke.Parent = frame

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, accentColor),
        ColorSequenceKeypoint.new(0.5, COLORS.BEE_GOLD),
        ColorSequenceKeypoint.new(1, accentColor),
    })
    grad.Parent = stroke

    local bee = Instance.new("TextLabel")
